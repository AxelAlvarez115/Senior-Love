<%- include('./partials/header') %>
<main>
  <%- include('./partials/alerts', {type:'global'}) %>

  <div class="ig-page">

    <%- include('partials/accountHeader', { user, photoCount, activeTab: 'evenements' }) %>

    <div class="ig-content">
      <% if (events && events.length) { %>
        <div class="card__container">
          <% for (const event of events) { %>
            <article class="card">
              <img class="card__img" src="/img/<%= event.Interest ? event.Interest.name : 'sport' %>.jpg" alt="<%= event.name %>">
              <div class="card__content">
                <div class="card__content__container">
                  <p class="card__content__container__theme"><%= event.Interest ? event.Interest.name : '' %></p>
                </div>
                <h2 class="card__content__title"><%= event.name %></h2>
                <p class="card__content__text">
                  <i class='bx bx-map-pin'></i> <%= event.city %>
                </p>
                <p class="card__content__text">
                  <i class='bx bx-calendar'></i> <%= new Date(event.date).toLocaleDateString('fr-FR') %>
                </p>
                <a class="card__content__link" href="/evenement/<%= event.id %>">En savoir plus</a>
              </div>
            </article>
          <% } %>
        </div>
      <% } else { %>
        <div class="ig-empty">
          <i class='bx bx-calendar-x'></i>
          <p>Vous ne participez à aucun évènement à venir.</p>
          <a href="/evenement" class="ig-btn ig-btn--red" style="text-decoration:none;">Voir les évènements</a>
        </div>
      <% } %>
    </div>

  </div>

  <script src="/js/forms.js" defer></script>
  <script type="module" src="/js/showPassword.js"></script>
  <%- include('./partials/userForm', user)%>
</main>
<%- include('./partials/footer') %>
