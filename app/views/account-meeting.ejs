<%- include('./partials/header')  %>
<main class="main">
    <div class="page-banner">
        <h1 class="page-banner__title">Mes rencontres</h1>
    </div>
    <%- include('./partials/alerts', {type:'global'}) %>
    <div class="account-page">
        <%- include('partials/accountNav', { page: 'rencontre' }) %>
        <% if (contacts && contacts.length) { %>
        <div class="card__container">
            <% for (const contact of contacts) { %>
            <article class="meeting">
                <div class="meeting__avatar">
                    <i class='bx bx-user'></i>
                </div>
                <h2 class="meeting__name"><%= contact.firstname %></h2>
                <ul class="meeting__infos">
                    <% if (contact.city) { %>
                    <li class="meeting__info-item">
                        <i class='bx bx-map-pin'></i> <%= contact.city %>
                    </li>
                    <% } %>
                    <% if (contact.bio) { %>
                    <p class="meeting__description"><%= contact.bio %></p>
                    <% } %>
                    <div class="meeting__actions">
                        <a class="card__content__link" href="/rencontre/profil/supprimer/<%= contact.id %>">Supprimer</a>
                        <a class="card__content__link card__content__link--icon" href="/messages/<%= contact.id %>">Message</a>
                        <a class="card__content__link card__content__link--icon" href="/rencontre/<%= contact.id %>">Profil</a>
                    </div>
                </ul>
            </article>
            <% } %>
        </div>
        <% } else { %>
        <div class="account-empty">
            <i class="bx bx-user-x account-empty__icon"></i>
            <p class="account-empty__text">Vous n'avez encore fait aucune rencontre.</p>
            <a href="/rencontre" class="form__button account-empty__cta">Trouver des rencontres</a>
        </div>
        <% } %>
    </div>
</main>
<%- include('./partials/footer')  %>
