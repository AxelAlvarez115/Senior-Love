<%- include('./partials/header') %>
<main>
  <%- include('./partials/alerts', {type:'global'}) %>

  <div class="ig-page">

    <%- include('partials/accountHeader', { user, photoCount, activeTab: 'rencontres' }) %>

    <div class="ig-content">
      <% if (contacts && contacts.length) { %>
        <div class="ig-contacts">
          <% for (const contact of contacts) { %>
            <article class="ig-contact-card">
              <div class="ig-contact-card__avatar">
                <% if (contact.avatar) { %>
                  <img src="/uploads/avatars/<%= contact.avatar %>" alt="<%= contact.firstname %>">
                <% } else { %>
                  <span>
                    <%= contact.firstname ? contact.firstname.charAt(0).toUpperCase() : '' %><%= contact.lastname ? contact.lastname.charAt(0).toUpperCase() : '' %>
                  </span>
                <% } %>
              </div>
              <div class="ig-contact-card__body">
                <h3 class="ig-contact-card__name"><%= contact.firstname %> <%= contact.lastname %></h3>
                <% if (contact.city) { %>
                  <p class="ig-contact-card__meta"><i class='bx bx-map-pin'></i> <%= contact.city %></p>
                <% } %>
              </div>
              <a class="ig-btn ig-btn--red ig-contact-card__link" href="/messages/<%= contact.id %>">
                <i class='bx bx-message-rounded'></i> Message
              </a>
              <a class="ig-btn ig-btn--outline ig-contact-card__link" href="/rencontre/<%= contact.id %>">
                <i class='bx bx-user'></i> Profil
              </a>
            </article>
          <% } %>
        </div>
      <% } else { %>
        <div class="ig-empty">
          <i class='bx bx-user-x'></i>
          <p>Vous n'avez encore fait aucune rencontre.</p>
          <a href="/rencontre" class="ig-btn ig-btn--red" style="text-decoration:none;">Trouver des rencontres</a>
        </div>
      <% } %>
    </div>

  </div>

  <script src="/js/forms.js" defer></script>
  <script type="module" src="/js/showPassword.js"></script>
  <%- include('./partials/userForm', user)%>
</main>
<%- include('./partials/footer') %>
