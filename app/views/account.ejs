<%- include('./partials/header')%>
<main>
  <%- include('partials/alerts', {type:'global'}) %>

  <div class="ig-page">

    <%- include('partials/accountHeader', { user, photoCount: photos.length, activeTab: 'photos' }) %>

    <!-- Grille photos -->
    <% if (photos.length > 0) { %>
      <div class="ig-grid">
        <% photos.forEach(function(photo) { %>
          <div class="ig-grid__item">
            <img class="ig-grid__img" src="/uploads/gallery/<%= photo.filename %>" alt="Photo">
            <div class="ig-grid__overlay">
              <form action="/compte/photo/<%= photo.id %>/supprimer" method="POST" onsubmit="return confirm('Supprimer cette photo ?')">
                <button class="ig-grid__delete-btn" type="submit">
                  <i class='bx bx-trash'></i> Supprimer
                </button>
              </form>
            </div>
          </div>
        <% }) %>
        <% if (photos.length < 8) { %>
          <form action="/compte/photo/ajouter" method="POST" enctype="multipart/form-data" class="ig-grid__add-form">
            <label class="ig-grid__add-tile">
              <i class='bx bx-plus'></i>
              <span>Ajouter</span>
              <input type="file" name="photo" accept="image/jpeg,image/png,image/webp" onchange="this.form.submit()">
            </label>
          </form>
        <% } %>
      </div>
    <% } else { %>
      <div class="ig-empty">
        <i class='bx bx-camera'></i>
        <p>Partagez votre première photo</p>
        <small>JPG, PNG ou WebP · max 5 Mo · 8 photos max</small>
        <form action="/compte/photo/ajouter" method="POST" enctype="multipart/form-data">
          <label class="ig-btn ig-btn--outline">
            <i class='bx bx-upload'></i> Ajouter une photo
            <input type="file" name="photo" accept="image/jpeg,image/png,image/webp" onchange="this.form.submit()">
          </label>
        </form>
      </div>
    <% } %>

  </div>

  <script src="/js/forms.js" defer></script>
  <script type="module" src="/js/showPassword.js"></script>
  <%- include('./partials/userForm', user)%>
</main>
<%- include('./partials/footer')%>
