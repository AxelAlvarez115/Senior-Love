<%- include('./partials/header')%>
<main>
  <div class="page-banner">
    <h1 class="page-banner__title">Mon compte</h1>
  </div>
  <%- include('partials/alerts', {type:'global'}) %>
  <div class="account-page">
    <%- include('partials/accountNav', { page: 'profil' }) %>
    <div class="account-card">
      <div class="account-profile-header">
        <div class="account-avatar">
          <%= user.firstname.charAt(0).toUpperCase() %><%= user.lastname.charAt(0).toUpperCase() %>
        </div>
        <div class="account-profile-header__info">
          <h2 class="account-profile-header__name"><%= user.firstname %> <%= user.lastname %></h2>
          <% if (user.city) { %>
            <p class="account-profile-header__location"><i class='bx bx-map-pin'></i> <%= user.city %></p>
          <% } %>
        </div>
      </div>
      <%- include('partials/alerts', {type:'profil'}) %>
      <ul class="profile-data">
        <li class="profile-data__item"><i class='bx bx-envelope'></i> <%= user.email %></li>
        <li class="profile-data__item"><i class='bx bx-phone'></i> <%= user.phone || '—' %></li>
        <li class="profile-data__item"><i class='bx bx-cake'></i> <%= user.date_of_birth ? new Date(user.date_of_birth).toLocaleDateString('fr-FR') : '—' %></li>
        <li class="profile-data__item"><i class='bx bx-user'></i> <%= user.gender || '—' %></li>
        <% if (user.bio) { %>
        <li class="profile-data__item profile-data__item--full"><i class='bx bx-notepad'></i> <%= user.bio %></li>
        <% } %>
      </ul>
      <button class="form__button" id="formsButton">Modifier le profil</button>
    </div>
  </div>
  <script src="/js/forms.js" defer></script>
  <script type="module" src="/js/showPassword.js"></script>
  <%- include('./partials/userForm', user)%>
</main>
<%- include('./partials/footer')%>
