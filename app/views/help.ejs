<%- include('./partials/header')%>
<main>
  <div class="page-banner">
    <h1 class="page-banner__title">Assistance</h1>
    <p class="page-banner__subtitle">Comment pouvons-nous vous aider ?</p>
  </div>
  <div class="help-page">
    <div class="help-cards">
      <a href="/faq" class="help-card">
        <i class='bx bx-help-circle help-card__icon'></i>
        <h2 class="help-card__title">Foire aux questions</h2>
        <p class="help-card__text">Trouvez les réponses aux questions fréquemment posées sur Senior Love.</p>
      </a>
      <a href="/assistance/telephone" class="help-card">
        <i class='bx bx-phone help-card__icon'></i>
        <h2 class="help-card__title">Assistance par téléphone</h2>
        <p class="help-card__text">Parlez directement à l'un de nos conseillers par téléphone.</p>
      </a>
      <a href="/assistance/message" class="help-card">
        <i class='bx bx-envelope help-card__icon'></i>
        <h2 class="help-card__title">Envoyer un message</h2>
        <p class="help-card__text">Contactez notre équipe par message pour toute demande d'assistance.</p>
      </a>
    </div>
  </div>
</main>
<%- include('./partials/footer')%>
