<%- include('partials/header')%><main class="auth-page">
  <div class="auth-card">
    <h1 class="auth-card__title">Connexion</h1>
    <p class="auth-card__subtitle">Bon retour parmi nous&nbsp;!</p>
    <form class="form" action='/connexion' method='POST'>
      <div class="form__flex">
        <%- include('./partials/alerts', {type:'global'}) %>
        <div class='form__div'>
          <label class="form__label" for='email'>Adresse email</label>
          <input class="form__input" type='email' name='email' id='email' placeholder=' ' autocomplete="email" />
        </div>
        <div class='form__div'>
          <label class="form__label" for='password'>
            Mot de passe
            <input class="showPassword" type='checkbox' value='password'>
          </label>
          <input class="form__input" type='password' name='password' id='password' placeholder=' ' autocomplete="current-password" />
        </div>
        <div class='form__div'>
          <button class="form__button" type='submit'>Se connecter</button>
        </div>
      </div>
    </form>
    <hr class="auth-card__divider">
    <p class="auth-card__switch">
      Pas encore de compte ?
      <a class="auth-card__link" href="/inscription">Créer un compte</a>
    </p>
  </div>
</main>
<script type="module" src="/js/showPassword.js"></script>
<%- include('partials/footer')%>
include('partials/footer')%>

