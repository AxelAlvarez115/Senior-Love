<%- include('partials/header')%>
<main>
  <%- include('partials/alerts', {type:'global'}) %>

  <div class="ig-page">

    <!-- En-tête profil -->
    <header class="ig-profile">

      <!-- Colonne avatar -->
      <div class="ig-profile__avatar-col">
        <div class="ig-profile__avatar-wrap">
          <% if (contact.avatar) { %>
            <img class="ig-profile__avatar-img" src="/uploads/avatars/<%= contact.avatar %>" alt="Photo de profil">
          <% } else { %>
            <div class="ig-profile__avatar-initials">
              <%= contact.firstname ? contact.firstname.charAt(0).toUpperCase() : '' %><%= contact.lastname ? contact.lastname.charAt(0).toUpperCase() : '' %>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Colonne infos -->
      <div class="ig-profile__info">

        <div class="ig-profile__name-row">
          <h1 class="ig-profile__name"><%= contact.firstname %> <%= contact.lastname %></h1>
          <% if (locals.isContact) { %>
            <a class="ig-btn ig-btn--outline" href="/messages/<%= contact.id %>">
              <i class='bx bx-message-rounded'></i> Envoyer un message
            </a>
          <% } else { %>
            <form action='/rencontre/<%= contact.id %>/ajouter' method='POST'>
              <button class="ig-btn ig-btn--red" type="submit">
                <i class='bx bx-user-plus'></i> Ajouter aux contacts
              </button>
            </form>
          <% } %>
        </div>

        <% if (photos && photos.length > 0) { %>
          <div class="ig-profile__stats">
            <span><strong><%= photos.length %></strong> photo<%= photos.length !== 1 ? 's' : '' %></span>
          </div>
        <% } %>

        <div class="ig-profile__meta">
          <% if (contact.city) { %><span class="ig-chip"><i class='bx bx-map-pin'></i> <%= contact.city %></span><% } %>
          <% if (contact.gender) { %><span class="ig-chip"><i class='bx bx-user-circle'></i> <%= contact.gender %></span><% } %>
        </div>

        <% if (contact.bio) { %>
          <p class="ig-profile__bio"><%= contact.bio %></p>
        <% } %>

      </div>
    </header>

    <!-- Grille photos (si disponible) -->
    <% if (photos && photos.length > 0) { %>
      <div class="ig-tabs">
        <span class="ig-tabs__tab ig-tabs__tab--active">
          <i class='bx bx-grid-alt'></i><span>Photos</span>
        </span>
      </div>
      <div class="ig-grid">
        <% photos.forEach(function(photo) { %>
          <div class="ig-grid__item">
            <img class="ig-grid__img" src="/uploads/gallery/<%= photo.filename %>" alt="Photo de <%= contact.firstname %>">
            <div class="ig-grid__overlay ig-grid__overlay--view">
              <i class='bx bx-zoom-in'></i>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>

  </div>
</main>
<%- include('./partials/footer')%>
