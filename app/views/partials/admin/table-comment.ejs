<div class="admin-page-header">
    <h1 class="admin-page-header__title">Commentaires</h1>
    <span class="admin-page-header__count"><%= comments.length %> résultat<%= comments.length > 1 ? 's' : '' %></span>
</div>

<div class="admin-table-wrapper">
    <div class="admin-table-header">
        <span class="admin-table-header__title">Liste des commentaires</span>
        <span class="admin-table-header__count"><%= comments.length %></span>
    </div>
    <table class="table">
        <thead>
            <tr>
                <th class="table__header-cell">#</th>
                <th class="table__header-cell">Contenu</th>
                <th class="table__header-cell">Auteur</th>
                <th class="table__header-cell">Évènement</th>
                <th class="table__header-cell">Date</th>
                <th class="table__header-cell">Actions</th>
            </tr>
        </thead>
        <tbody>
            <% for (const comment of comments) { %>
                <tr class="table__row">
                    <td class="table__cell table__cell--id"><%= comment.id %></td>
                    <td class="table__cell table__cell--truncate"><%= comment.contents %></td>
                    <td class="table__cell">
                        <% if (comment.User) { %>
                            <a class="table__link" href="/rencontre/<%= comment.User.id %>"><%= comment.User.firstname %> <%= comment.User.lastname %></a>
                        <% } else { %>
                            —
                        <% } %>
                    </td>
                    <td class="table__cell">
                        <% if (comment.Event) { %>
                            <a class="table__link" href="/evenement/<%= comment.Event.id %>"><%= comment.Event.name %></a>
                        <% } else { %>
                            —
                        <% } %>
                    </td>
                    <td class="table__cell"><%= new Date(comment.createdAt).toLocaleDateString('fr-FR') %></td>
                    <td class="table__action-cell">
                        <div class="table__actions">
                            <form action="/comments/delete/<%= comment.id %>" method="POST">
                                <button type="submit" class="table__action-btn table__action-btn--delete" title="Supprimer">
                                    <i class='bx bx-trash'></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            <% } %>
        </tbody>
    </table>
</div>
