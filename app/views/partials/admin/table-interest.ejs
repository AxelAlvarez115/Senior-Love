<div class="admin-page-header">
    <h1 class="admin-page-header__title">Centres d'intérêt</h1>
    <div style="display:flex;gap:0.75rem;align-items:center;">
        <span class="admin-page-header__count"><%= interests.length %> résultat<%= interests.length > 1 ? 's' : '' %></span>
        <button class="admin-create-btn" onclick="openAdminModal('modal-interest-create')">
            <i class='bx bx-plus'></i> Ajouter
        </button>
    </div>
</div>

<div class="admin-table-wrapper">
    <div class="admin-table-header">
        <span class="admin-table-header__title">Liste des centres d'intérêt</span>
        <span class="admin-table-header__count"><%= interests.length %></span>
    </div>
    <table class="table">
        <thead>
            <tr>
                <th class="table__header-cell">#</th>
                <th class="table__header-cell">Nom</th>
                <th class="table__header-cell">Modifier</th>
                <th class="table__header-cell">Actions</th>
            </tr>
        </thead>
        <tbody>
            <% for (const interest of interests) { %>
                <tr class="table__row">
                    <td class="table__cell table__cell--id"><%= interest.id %></td>
                    <td class="table__cell"><%= interest.name %></td>
                    <td class="table__cell">
                        <form action="/interests/update/<%= interest.id %>" method="POST" class="table__inline-form">
                            <input type="text" name="name" value="<%= interest.name %>" class="table__input" required maxlength="20">
                            <button type="submit" class="table__action-btn table__action-btn--save" title="Sauvegarder">
                                <i class='bx bx-check'></i>
                            </button>
                        </form>
                    </td>
                    <td class="table__action-cell">
                        <div class="table__actions">
                            <form action="/interests/delete/<%= interest.id %>" method="POST">
                                <button type="submit" class="table__action-btn table__action-btn--delete" title="Supprimer">
                                    <i class='bx bx-trash'></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            <% } %>
        </tbody>
    </table>
</div>

<!-- Modal création centre d'intérêt -->
<div id="modal-interest-create" class="modal hidden">
    <div class="modal__content">
        <div class="modal__header">
            <h2 class="modal__title">Ajouter un centre d'intérêt</h2>
            <button class="modal__close" onclick="closeAdminModal('modal-interest-create')">&times;</button>
        </div>
        <form action="/admin/interests/create" method="POST">
            <div class="modal__body modal__body--single">
                <div class="modal__field modal__field--full">
                    <label class="modal__label" for="i-name">Nom *</label>
                    <input class="modal__input" type="text" id="i-name" name="name" required maxlength="20" placeholder="Ex : Peinture">
                </div>
            </div>
            <div class="modal__footer">
                <button type="button" class="modal__btn modal__btn--cancel" onclick="closeAdminModal('modal-interest-create')">Annuler</button>
                <button type="submit" class="modal__btn modal__btn--primary">Créer</button>
            </div>
        </form>
    </div>
</div>

<script src="/js/adminCreate.js" defer></script>
