<div class="darkBackground hidden">
    <div class="forms">
        <button class="forms__cancel" type="button"><i class='bx bx-x'></i></button>

        <div class="forms__switch">
            <button type="button" class="forms__switch__button active" data-target="infoForm">Informations</button>
            <button type="button" class="forms__switch__button" data-target="emailForm">Email</button>
            <button type="button" class="forms__switch__button" data-target="passwordForm">Mot de passe</button>
            <button type="button" class="forms__switch__button" data-target="deleteForm">Supprimer</button>
        </div>

        <div class="forms__content">
            <h2 class="forms__content__title">Modifier les informations de votre compte</h2>

            <!-- Informations personnelles -->
            <form class="form" id="infoForm" action="/compte/infos" method="POST">
                <div class="form__grid">
                    <% if (isAdmin) { %>
                        <div class="form__div">
                            <label class="form__label" for="firstname">Prénom</label>
                            <input class="form__input" type="text" name="firstname" id="firstname" value="<%= user.firstname %>" required maxlength="40">
                        </div>
                        <div class="form__div">
                            <label class="form__label" for="lastname">Nom</label>
                            <input class="form__input" type="text" name="lastname" id="lastname" value="<%= user.lastname %>" required maxlength="40">
                        </div>
                        <div class="form__div form__div--full">
                            <label class="form__label" for="email-info">Email</label>
                            <input class="form__input" type="email" name="email" id="email-info" value="<%= user.email %>" required maxlength="40">
                        </div>
                    <% } %>

                    <div class="form__div form__div--full">
                        <fieldset class="form__radio__container">
                            <legend>Genre</legend>
                            <div class="form__radio">
                                <input class="form__radio__input" type="radio" name="gender" id="femme" value="femme" <%= user.gender === 'femme' ? 'checked' : '' %>>
                                <label class="form__radio__label" for="femme">Femme</label>
                                <input class="form__radio__input" type="radio" name="gender" id="homme" value="homme" <%= user.gender === 'homme' ? 'checked' : '' %>>
                                <label class="form__radio__label" for="homme">Homme</label>
                                <input class="form__radio__input" type="radio" name="gender" id="autre" value="autre" <%= user.gender === 'autre' ? 'checked' : '' %>>
                                <label class="form__radio__label" for="autre">Autre</label>
                            </div>
                        </fieldset>
                    </div>

                    <div class="form__div">
                        <label class="form__label" for="city">Ville</label>
                        <input class="form__input" type="text" name="city" id="city" value="<%= user.city %>" required maxlength="58">
                    </div>

                    <div class="form__div form__div--full">
                        <label class="form__label" for="bio">À propos de vous</label>
                        <textarea class="form__input form__textarea" name="bio" id="bio" rows="3" maxlength="255" placeholder="Décrivez-vous en quelques mots…"><%= user.bio || '' %></textarea>
                    </div>
                </div>
                <div class="form__actions">
                    <button class="form__button" type="submit">Mettre à jour</button>
                </div>
            </form>

            <!-- Changer l'email -->
            <form class="form hidden" id="emailForm" action="/compte/email" method="POST">
                <div class="form__grid">
                    <div class="form__div form__div--full">
                        <label class="form__label" for="newEmail">Nouvel email</label>
                        <input class="form__input" type="email" name="email" id="newEmail" placeholder="votre@email.fr">
                    </div>
                    <div class="form__div form__div--full">
                        <label class="form__label" for="emailValidate">Confirmer le nouvel email</label>
                        <input class="form__input" type="email" name="emailValidate" id="emailValidate" placeholder="votre@email.fr">
                    </div>
                    <div class="form__div form__div--full">
                        <label class="form__label" for="passwordEmail">Mot de passe actuel</label>
                        <input class="form__input" type="password" name="passwordEmail" id="passwordEmail" placeholder="••••••••">
                        <label class="show-password-row">
                            <input class="showPassword" type="checkbox" value="passwordEmail"> Afficher le mot de passe
                        </label>
                    </div>
                </div>
                <div class="form__actions">
                    <button class="form__button" type="submit">Changer l'email</button>
                </div>
            </form>

            <!-- Changer le mot de passe -->
            <form class="form hidden" id="passwordForm" action="/compte/mot-de-passe" method="POST">
                <div class="form__grid">
                    <div class="form__div form__div--full">
                        <label class="form__label" for="password">Nouveau mot de passe</label>
                        <input class="form__input" type="password" name="password" id="password" placeholder="••••••••">
                        <label class="show-password-row">
                            <input type="checkbox" class="showPassword" value="password"> Afficher
                        </label>
                    </div>
                    <div class="form__div form__div--full">
                        <label class="form__label" for="validatePassword">Confirmer le nouveau mot de passe</label>
                        <input class="form__input" type="password" name="validatePassword" id="validatePassword" placeholder="••••••••">
                        <label class="show-password-row">
                            <input type="checkbox" class="showPassword" value="validatePassword"> Afficher
                        </label>
                    </div>
                    <div class="form__div form__div--full">
                        <label class="form__label" for="currentPassword">Mot de passe actuel</label>
                        <input class="form__input" type="password" name="currentPassword" id="currentPassword" placeholder="••••••••">
                        <label class="show-password-row">
                            <input type="checkbox" class="showPassword" value="currentPassword"> Afficher
                        </label>
                    </div>
                </div>
                <div class="form__actions">
                    <button class="form__button" type="submit">Modifier le mot de passe</button>
                </div>
            </form>

            <!-- Supprimer le compte -->
            <form class="form hidden" id="deleteForm" action="/compte/supprimer" method="POST">
                <div class="delete-zone">
                    <p class="delete-zone__title"><i class='bx bx-error-circle'></i> Zone dangereuse</p>
                    <div class="form__grid">
                        <div class="form__div form__div--full">
                            <label class="form__label" for="deletePassword">Mot de passe</label>
                            <input class="form__input" type="password" name="deletePassword" id="deletePassword" placeholder="••••••••">
                            <label class="show-password-row">
                                <input type="checkbox" class="showPassword" value="deletePassword"> Afficher
                            </label>
                        </div>
                        <div class="form__div form__div--full">
                            <label class="form__label" for="validateSentence">Pour confirmer, saisissez exactement :</label>
                            <span class="form__span">Je souhaite supprimer mon compte</span>
                            <input class="form__input" type="text" name="validateSentence" id="validateSentence" placeholder="Je souhaite supprimer mon compte">
                        </div>
                    </div>
                </div>
                <div class="form__actions">
                    <button class="form__button form__button--danger" type="submit">Supprimer définitivement</button>
                </div>
            </form>

        </div>
    </div>
</div>
